# AI question generator (sub-project: question-generator-agent)
OPENAI_API_KEY="REPLACE_ME"
AI_MODEL=gpt-4o-mini
AI_QUESTION_COUNT=6
# Model the pipeline switches to after the primary model's drafts keep failing validation
