generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  clerkId      String      @unique
  name         String
  email        String      @unique
  profileImage String?
  title        String      @default("")
  bio          String      @default("")
  phone        String      @default("")
  timezone     String      @default("UTC")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  interviews   Interview[]

  @@map("users")
}

model Interview {
  id             String   @id @default(cuid())
  interviewerId  String
  interviewer    User     @relation(fields: [interviewerId], references: [id])
  candidateName  String
  candidateEmail String
  role           String
  scheduledAt    DateTime
  status         String   @default("scheduled")
  duration       Int      @default(60)
  interviewType  String   @default("technical")
  notes          String   @default("")
  company        String   @default("")
  // The interviewer opts in to the AI interviewer for this interview; language of its voice/text.
  aiInterviewerEnabled Boolean @default(false)
  interviewLanguage    String  @default("en")
  codeSnapshot   String?
  codeLanguage   String?  @default("javascript")
  questions      Json?
  // SHA-256 of the candidate invite secret (the secret itself is never stored).
  inviteTokenHash String?   @unique
  inviteCreatedAt DateTime?
  // Sessions with the AI interviewer of the room.
  practiceSessions  AiPracticeSession[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("interviews")
}

model Session {
  id         String   @id @default(cuid())
  problem    String
  difficulty String
  category   String
  solution   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("sessions")
}

// One practice session with the AI interviewer. The conversation itself lives in the
// LangGraph checkpointer (thread "practice:<id>"), not here. Not "practice_sessions": that
// table belongs to an older, unrelated practice feature (branch worktree-ai-avatar-interviewer).
model AiPracticeSession {
  id           String    @id @default(cuid())
  interviewId  String
  interview    Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  status       String    @default("active")
  language     String
  code         String?
  report       Json?
  messageCount Int       @default(0)
  mode         String    @default("text")
  presentedIndex Int?
  avatarTokens Int       @default(0)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([interviewId])
  @@map("ai_practice_sessions")
}
